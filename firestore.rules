rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: recipes
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required)
    //   - authorId: string (required, immutable)
    //   - authorName: string
    //   - images: list (strings)
    //   - duration: string
    //   - servings: number
    //   - difficulty: string (einfach|mittel|schwer)
    //   - categories: list (strings)
    //   - dietary: list (strings)
    //   - tags: list (strings)
    //   - ingredients: list (strings, required)
    //   - instructions: list (strings, required)
    //   - notes: string
    //   - createdAt: string (ISO 8601, required)
    //   - isPublic: bool (required)
    //
    // Collection: users
    // Document ID: userId (uid)
    // Fields:
    //   - uid: string (required, immutable)
    //   - displayName: string
    //   - email: string (required, PII)
    //   - photoURL: string
    //   - role: string (admin|user)
    //
    // Collection: ratings
    // Document ID: auto-generated
    // Fields:
    //   - recipeId: string (required)
    //   - userId: string (required, immutable)
    //   - score: number (1-5, required)
    //   - createdAt: string (ISO 8601, required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.authorId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "nl.leitschuh@gmail.com" ||
         request.auth.token.email == "noah@leitschuh.de");
    }

    function isWhitelistEnforced() {
      let settings = get(/databases/$(database)/documents/settings/global);
      return settings == null || settings.data.restrictToWhitelist == true;
    }

    function isAllowed() {
      return isAuthenticated() && 
        (!isWhitelistEnforced() ||
         exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)) || 
         isAdmin());
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'authorId', 'ingredients', 'instructions', 'createdAt', 'isPublic']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.authorId is string &&
             data.ingredients is list && data.ingredients.size() > 0 && data.ingredients.size() < 100 &&
             data.instructions is list && data.instructions.size() > 0 && data.instructions.size() < 100 &&
             data.createdAt is string &&
             data.isPublic is bool &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() < 100)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() < 50)) &&
             (!('servings' in data) || (data.servings is number && data.servings >= 0)) &&
             (!('difficulty' in data) || (data.difficulty in ['einfach', 'mittel', 'schwer'])) &&
             (!('categories' in data) || (data.categories is list && data.categories.size() < 20)) &&
             (!('dietary' in data) || (data.dietary is list && data.dietary.size() < 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() < 20)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 10000)) &&
             (!('images' in data) || (data.images is list && data.images.size() < 10)) &&
             (!('averageRating' in data) || (data.averageRating is number && data.averageRating >= 1 && data.averageRating <= 5)) &&
             (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0));
    }

    function isValidRating(data) {
      return data.keys().hasAll(['recipeId', 'userId', 'score', 'createdAt']) &&
             data.recipeId is string &&
             data.userId is string &&
             data.score is number && data.score >= 1 && data.score <= 5 &&
             data.createdAt is string;
    }

    function isValidShoppingList(data) {
      return data.keys().hasAll(['name', 'userId', 'items']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.userId is string &&
             data.items is list && data.items.size() <= 200 &&
             (!('recipes' in data) || data.recipes is list) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidRecipeCollection(data) {
      return data.keys().hasAll(['userId', 'name', 'recipeIds', 'isShared']) &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.recipeIds is list && data.recipeIds.size() <= 1000 &&
             data.isShared is bool &&
             (!('description' in data) || (data.description is string && data.description.size() < 500)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() < 50)) &&
             (!('color' in data) || (data.color is string && data.color.size() < 50)) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidMealPlan(data) {
      return data.keys().hasAll(['userId', 'weekStart', 'meals']) &&
             data.userId is string &&
             data.weekStart is string && data.weekStart.size() == 10 &&
             data.meals is list && data.meals.size() <= 50;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1000)) &&
             (!('role' in data) || data.role in ['admin', 'user']) &&
             (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 1000));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /settings/{settingId} {
      allow read: if true; // Allow public read for login screen config
      allow write: if isAdmin();
    }

    match /allowedUsers/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Users can only read their own profile (contains PII like email)
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create/update their own profile, but can't escalate role
      allow create: if (isOwner(userId) && isValidUser(request.resource.data) && 
                      (!('role' in request.resource.data) || request.resource.data.role == 'user')) || isAdmin();
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.role == resource.data.role) || 
                      (isAdmin() && isValidUser(request.resource.data));
      allow delete: if isAdmin();
    }

    match /recipes/{recipeId} {
      // Public recipes are readable by all authenticated family members
      // Private recipes are only readable by the owner
      allow read: if isAllowed() && (resource.data.isPublic == true || isDocOwner() || isAdmin());
      
      // Allow listing recipes if the query is properly filtered
      allow list: if isAllowed();
      
      allow create: if isAllowed() && isValidRecipe(request.resource.data) && 
                      request.resource.data.authorId == request.auth.uid;
                      
      allow update: if isAllowed() && isValidRecipe(request.resource.data) &&
                      (isDocOwner() || isAdmin() || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'ratingCount'])));
                      
      allow delete: if isDocOwner() || isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidRating(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidRating(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /shoppingLists/{listId} {
      allow read: if isAllowed() && resource.data.userId == request.auth.uid;
      allow list: if isAllowed() && resource.data.userId == request.auth.uid;
      allow create: if isAllowed() && isValidShoppingList(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidShoppingList(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /collections/{collectionId} {
      allow read: if isAllowed() && (resource.data.userId == request.auth.uid || resource.data.isShared == true);
      allow list: if isAllowed() && (resource.data.userId == request.auth.uid || resource.data.isShared == true);
      allow create: if isAllowed() && isValidRecipeCollection(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidRecipeCollection(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /mealPlans/{planId} {
      allow read: if isAllowed() && resource.data.userId == request.auth.uid;
      allow list: if isAllowed() && resource.data.userId == request.auth.uid;
      allow create: if isAllowed() && isValidMealPlan(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidMealPlan(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }
  }
}
