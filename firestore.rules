rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: recipes
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required)
    //   - authorId: string (required, immutable)
    //   - authorName: string
    //   - images: list (strings)
    //   - duration: string
    //   - servings: number
    //   - difficulty: string (einfach|mittel|schwer)
    //   - categories: list (strings)
    //   - dietary: list (strings)
    //   - tags: list (strings)
    //   - ingredients: list (strings, required)
    //   - instructions: list (strings, required)
    //   - notes: string
    //   - createdAt: string (ISO 8601, required)
    //   - isPublic: bool (required)
    //
    // Collection: users
    // Document ID: userId (uid)
    // Fields:
    //   - uid: string (required, immutable)
    //   - displayName: string
    //   - email: string (required, PII)
    //   - photoURL: string
    //   - role: string (admin|user)
    //
    // Collection: ratings
    // Document ID: auto-generated
    // Fields:
    //   - recipeId: string (required)
    //   - userId: string (required, immutable)
    //   - score: number (1-5, required)
    //   - createdAt: string (ISO 8601, required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.authorId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "nl.leitschuh@gmail.com" ||
         request.auth.token.email == "noah@leitschuh.de");
    }

    function isWhitelistEnforced() {
      let settings = get(/databases/$(database)/documents/settings/global);
      return settings == null || settings.data.restrictToWhitelist == true;
    }

    function isAllowed() {
      return isAuthenticated() && 
        (!isWhitelistEnforced() ||
         exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)) || 
         isAdmin());
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'authorId', 'ingredients', 'instructions', 'createdAt', 'isPublic']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.authorId is string &&
             data.ingredients is list && data.ingredients.size() > 0 && data.ingredients.size() < 100 &&
             data.instructions is list && data.instructions.size() > 0 && data.instructions.size() < 100 &&
             data.createdAt is string &&
             data.isPublic is bool &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() < 100)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() < 50)) &&
             (!('servings' in data) || (data.servings is number && data.servings >= 0)) &&
             (!('difficulty' in data) || (data.difficulty in ['einfach', 'mittel', 'schwer'])) &&
             (!('categories' in data) || (data.categories is list && data.categories.size() < 20)) &&
             (!('dietary' in data) || (data.dietary is list && data.dietary.size() < 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() < 20)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 10000)) &&
             (!('images' in data) || (data.images is list && data.images.size() < 10)) &&
             (!('averageRating' in data) || (data.averageRating is number && data.averageRating >= 1 && data.averageRating <= 5)) &&
             (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0));
    }

    function isValidRating(data) {
      return data.keys().hasAll(['recipeId', 'userId', 'score', 'createdAt']) &&
             data.recipeId is string &&
             data.userId is string &&
             data.score is number && data.score >= 1 && data.score <= 5 &&
             data.createdAt is string;
    }

    function isValidShoppingList(data) {
      return data.keys().hasAll(['name', 'userId', 'items']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.userId is string &&
             data.items is list && data.items.size() <= 200 &&
             (!('recipes' in data) || data.recipes is list) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidRecipeCollection(data) {
      return data.keys().hasAll(['userId', 'name', 'recipeIds', 'isShared']) &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.recipeIds is list && data.recipeIds.size() <= 1000 &&
             data.isShared is bool &&
             (!('description' in data) || (data.description is string && data.description.size() < 500)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() < 50)) &&
             (!('color' in data) || (data.color is string && data.color.size() < 50)) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidMealPlan(data) {
      return data.keys().hasAll(['userId', 'weekStart', 'meals']) &&
             data.userId is string &&
             data.weekStart is string && data.weekStart.size() == 10 &&
             data.meals is list && data.meals.size() <= 50;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1000)) &&
             (!('role' in data) || data.role in ['admin', 'user']) &&
             (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 1000));
    }

    function isValidRecipeVariant(data) {
      return data.keys().hasAll(['parentRecipeId', 'ownerId', 'variantName', 'differences', 'createdAt']) &&
             data.parentRecipeId is string &&
             data.ownerId is string &&
             data.variantName is string && data.variantName.size() > 0 && data.variantName.size() < 100 &&
             data.differences is map &&
             data.createdAt is string;
    }

    function isValidRecipeVersion(data) {
      return data.keys().hasAll(['recipeId', 'version', 'changes', 'changedBy', 'changeDate']) &&
             data.recipeId is string &&
             data.version is number && data.version >= 1 &&
             data.changes is map &&
             data.changedBy is string &&
             data.changeDate is string &&
             (!('changeDescription' in data) || (data.changeDescription is string && data.changeDescription.size() < 500));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['recipeId', 'userId', 'text', 'mentions', 'createdAt']) &&
             data.recipeId is string &&
             data.userId is string &&
             data.text is string && data.text.size() > 0 && data.text.size() < 5000 &&
             data.mentions is list && data.mentions.size() <= 50 &&
             data.createdAt is string &&
             (!('replyTo' in data) || data.replyTo is string);
    }
    
    function isValidCookingLog(data) {
      return data.keys().hasAll(['recipeId', 'userId', 'cookedDate', 'photos', 'createdAt']) &&
             data.recipeId is string &&
             data.userId is string &&
             data.cookedDate is string &&
             data.photos is list && data.photos.size() <= 20 &&
             data.createdAt is string &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 5000)) &&
             (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5));
    }
    
    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'type', 'targetId', 'createdAt']) &&
             data.userId is string &&
             data.type in ['recipe_added', 'cooking_log', 'comment', 'reaction', 'recommendation'] &&
             data.targetId is string &&
             data.createdAt is string &&
             (!('targetName' in data) || data.targetName is string) &&
             (!('metadata' in data) || data.metadata is map);
    }
    
    function isValidReaction(data) {
      return data.keys().hasAll(['recipeId', 'userId', 'emoji', 'createdAt']) &&
             data.recipeId is string &&
             data.userId is string &&
             data.emoji is string && data.emoji.size() > 0 && data.emoji.size() < 10 &&
             data.createdAt is string;
    }
    
    function isValidRecommendation(data) {
      return data.keys().hasAll(['recipeId', 'fromUserId', 'toUserId', 'createdAt']) &&
             data.recipeId is string &&
             data.fromUserId is string &&
             data.toUserId is string &&
             data.createdAt is string &&
             (!('message' in data) || (data.message is string && data.message.size() < 1000));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /settings/{settingId} {
      allow read: if true; // Allow public read for login screen config
      allow write: if isAdmin();
    }

    match /allowedUsers/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Users can only read their own profile (contains PII like email)
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create/update their own profile, but can't escalate role
      allow create: if (isOwner(userId) && isValidUser(request.resource.data) && 
                      (!('role' in request.resource.data) || request.resource.data.role == 'user')) || isAdmin();
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.role == resource.data.role) || 
                      (isAdmin() && isValidUser(request.resource.data));
      allow delete: if isAdmin();
    }

    match /recipes/{recipeId} {
      // Public recipes are readable by all authenticated family members
      // Private recipes are only readable by the owner
      allow read: if isAllowed() && (resource.data.isPublic == true || isDocOwner() || isAdmin());
      
      // Allow listing recipes if the query is properly filtered
      allow list: if isAllowed();
      
      allow create: if isAllowed() && isValidRecipe(request.resource.data) && 
                      request.resource.data.authorId == request.auth.uid;
                      
      allow update: if isAllowed() && isValidRecipe(request.resource.data) &&
                      (isDocOwner() || isAdmin() || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'ratingCount'])));
                      
      allow delete: if isDocOwner() || isAdmin();
      
      match /versions/{versionId} {
        allow read: if isAllowed();
        allow create: if isAllowed() && isValidRecipeVersion(request.resource.data) &&
                        request.resource.data.changedBy == request.auth.uid;
        allow update: if false; // Versions are immutable
        allow delete: if isAdmin();
      }
    }

    match /recipeVariants/{variantId} {
      allow read: if isAllowed();
      allow list: if isAllowed();
      allow create: if isAllowed() && isValidRecipeVariant(request.resource.data) && 
                      request.resource.data.ownerId == request.auth.uid;
      allow update: if isAllowed() && isValidRecipeVariant(request.resource.data) && 
                      request.resource.data.ownerId == request.auth.uid &&
                      resource.data.ownerId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.ownerId == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidRating(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidRating(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /shoppingLists/{listId} {
      allow read: if isAllowed() && resource.data.userId == request.auth.uid;
      allow list: if isAllowed() && resource.data.userId == request.auth.uid;
      allow create: if isAllowed() && isValidShoppingList(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidShoppingList(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /collections/{collectionId} {
      allow read: if isAllowed() && (resource.data.userId == request.auth.uid || resource.data.isShared == true);
      allow list: if isAllowed() && (resource.data.userId == request.auth.uid || resource.data.isShared == true);
      allow create: if isAllowed() && isValidRecipeCollection(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidRecipeCollection(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /mealPlans/{planId} {
      allow read: if isAllowed() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAllowed() && resource.data.userId == request.auth.uid;
      allow create: if isAllowed() && isValidMealPlan(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidMealPlan(request.resource.data) && 
                      request.resource.data.userId == request.auth.uid &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read: if isAllowed();
      allow list: if isAllowed();
      allow create: if isAllowed() && isValidComment(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidComment(request.resource.data) && request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /cookingLogs/{logId} {
      allow read: if isAllowed();
      allow list: if isAllowed();
      allow create: if isAllowed() && isValidCookingLog(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed() && isValidCookingLog(request.resource.data) && request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read: if isAllowed();
      allow list: if isAllowed();
      allow create: if isAllowed() && isValidActivity(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /reactions/{reactionId} {
      allow read: if isAllowed();
      allow list: if isAllowed();
      allow create: if isAllowed() && isValidReaction(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.userId == request.auth.uid;
    }

    match /recommendations/{recommendationId} {
      allow read: if isAllowed() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow list: if isAllowed() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isAllowed() && isValidRecommendation(request.resource.data) && request.resource.data.fromUserId == request.auth.uid;
      allow delete: if isAllowed() && resource.data.fromUserId == request.auth.uid;
    }
  }
}
