{
  "entities": {
    "Recipe": {
      "title": "Recipe",
      "description": "A culinary recipe with ingredients and instructions.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Name of the dish" },
        "authorId": { "type": "string", "description": "UID of the creator" },
        "authorName": { "type": "string", "description": "Display name of the creator" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "URLs of recipe photos" },
        "duration": { "type": "string", "description": "Prep/cook time (e.g., '30 Min')" },
        "servings": { "type": "number", "description": "Number of portions" },
        "difficulty": { "type": "string", "enum": ["einfach", "mittel", "schwer"] },
        "categories": { "type": "array", "items": { "type": "string" } },
        "dietary": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "ingredients": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPublic": { "type": "boolean", "description": "Whether the recipe is shared with the family" },
        "averageRating": { "type": "number" },
        "ratingCount": { "type": "number" }
      },
      "required": ["title", "authorId", "ingredients", "instructions"]
    },
    "User": {
      "title": "User",
      "description": "User profile data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email"]
    },
    "AllowedUser": {
      "title": "AllowedUser",
      "description": "A user email allowed to access the app.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "allowGoogleLogin": { "type": "boolean" },
        "allowEmailLogin": { "type": "boolean" },
        "restrictToWhitelist": { "type": "boolean" },
        "allowRegistration": { "type": "boolean" },
        "allowMagicLink": { "type": "boolean" }
      }
    },
    "Rating": {
      "title": "Rating",
      "description": "A user's star rating for a recipe.",
      "type": "object",
      "properties": {
        "recipeId": { "type": "string" },
        "userId": { "type": "string" },
        "score": { "type": "number", "description": "1-5 stars" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipeId", "userId", "score"]
    },
    "ShoppingList": {
      "title": "ShoppingList",
      "description": "A user's shopping list generated from recipes.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "recipes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recipeId": { "type": "string" },
              "servings": { "type": "number" }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredient": { "type": "string" },
              "quantity": { "type": "string" },
              "category": { "type": "string" },
              "checked": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "userId", "items"]
    }
    "RecipeCollection": {
      "title": "RecipeCollection",
      "description": "User created collections of recipes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "recipeIds": { "type": "array", "items": { "type": "string" } },
        "isShared": { "type": "boolean" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "recipeIds", "isShared"]
    },
    "MealPlan": {
      "title": "MealPlan",
      "description": "User created meal plan for a week.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "weekStart": { "type": "string" },
        "meals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "day": { "type": "string" },
              "type": { "type": "string" },
              "recipeId": { "type": "string" },
              "servings": { "type": "number" },
              "notes": { "type": "string" }
            },
            "required": ["id", "day", "type", "servings"]
          }
        }
      },
      "required": ["userId", "weekStart", "meals"]
    }
  },
  "firestore": {
    "/mealPlans/{planId}": {
      "schema": "MealPlan",
      "description": "Collection of all meal plans."
    },
    "/collections/{collectionId}": {
      "schema": "RecipeCollection",
      "description": "Collection of custom recipe lists."
    },
    "/shoppingLists/{listId}": {
      "schema": "ShoppingList",
      "description": "Collection of all shopping lists."
    },
    "/recipes/{recipeId}": {
      "schema": "Recipe",
      "description": "Collection of all recipes."
    },
    "/ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Collection of all user ratings."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/allowedUsers/{email}": {
      "schema": "AllowedUser",
      "description": "Whitelist of allowed user emails."
    },
    "/settings/global": {
      "schema": "Settings",
      "description": "Global app configuration."
    }
  }
}
