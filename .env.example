# GEMINI_API_KEY: Required for recipe intelligence, semantic search, and scaling features.
# Get a free key at: https://aistudio.google.com/app/apikey
# In AI Studio, add this to the "Secrets" panel (key icon in the sidebar).
# For Netlify/Production, add it as an environment variable in the dashboard.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
